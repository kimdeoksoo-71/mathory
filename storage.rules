rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // 문제 미디어: problems/{problemId}/{fileName}
    // 읽기: 모두 허용 (Firebase download URL의 토큰이 사실상 접근 제어 역할).
    //       URL을 모르면 추측 불가능하며, URL은 Firestore 규칙으로 보호된
    //       blocks/{id}.raw_text 안에만 저장됨.
    // 쓰기: 로그인 사용자만, 10MB 이하, 이미지 또는 .ggb 파일
    match /problems/{problemId}/{fileName=**} {
      allow read;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024  // 10MB
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/vnd.geogebra.file'
          || request.resource.contentType == 'application/octet-stream'
        );
    }

    // 기타 경로는 기본 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
