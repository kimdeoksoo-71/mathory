rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== users 컬렉션 =====
    // 누구나 다른 사용자의 표시명/사진 조회 가능 (공유 시 작성자 표시용)
    // 단, 본인 문서만 쓰기 가능
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // 사용자 스니펫: 본인만
      match /math_snippets/{snippetId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ===== problems 컬렉션 =====
    match /problems/{problemId} {

      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner() {
        return isSignedIn() && resource.data.authorUid == request.auth.uid;
      }
      function visibility() {
        return resource.data.get('visibility', 'private');
      }
      function isPublic() {
        return visibility() == 'public';
      }
      // Stage 2: 멤버 공유
      function isMember() {
        return isSignedIn()
          && (request.auth.uid in resource.data.get('memberUids', []));
      }
      // 멤버 본인 "공유 해제" — members/memberUids/updated_at만 변경하고 자기 uid를 제거
      function isMemberSelfLeave() {
        return isSignedIn()
          && (request.auth.uid in resource.data.get('memberUids', []))
          && !(request.auth.uid in request.resource.data.get('memberUids', []))
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['members', 'memberUids', 'updated_at']);
      }

      // 읽기: 본인 OR public OR member
      allow read: if isOwner() || isPublic() || isMember();

      // 생성: 로그인한 사용자가 자기 이름으로만 작성 가능
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid;

      // 수정: 오너 OR 멤버 본인 공유 해제 / 삭제: 오너만
      allow update: if isOwner() || isMemberSelfLeave();
      allow delete: if isOwner();

      // ===== problems/{id}/* 모든 서브컬렉션 =====
      match /{subcollection}/{docId} {
        function parentData() {
          return get(/databases/$(database)/documents/problems/$(problemId)).data;
        }
        function parentOwner() {
          return isSignedIn() && parentData().authorUid == request.auth.uid;
        }
        function parentIsPublic() {
          return parentData().get('visibility', 'private') == 'public';
        }
        function parentIsMember() {
          return isSignedIn()
            && (request.auth.uid in parentData().get('memberUids', []));
        }
        // subcollection 이름이 'xxx_blocks' 형태면 tabId 추출, 아니면 빈 문자열
        function tabIdFromSubcol() {
          return subcollection.split('_blocks')[0];
        }
        function isBlocksSubcol() {
          return subcollection.matches('.*_blocks');
        }
        // 멤버 탭 가시성: memberTabVisibility 없거나 해당 tabId가 true면 허용
        function tabAllowedForMember() {
          return parentData().get('memberTabVisibility', {})
            .get(tabIdFromSubcol(), true) == true;
        }

        // 탭 블록(xxx_blocks): 멤버는 해당 탭이 공개일 때만 읽기
        allow read: if parentOwner()
          || parentIsPublic()
          || (parentIsMember() && (!isBlocksSubcol() || tabAllowedForMember()));
        // 쓰기는 오너만 (Stage 3 댓글은 별도 규칙으로 추후 분리)
        allow write: if parentOwner();
      }
    }

    // ===== shares 컬렉션 (Stage 1: 공유 링크 — 스냅샷 모델) =====
    //   - share 문서에 problem + tabBlocks 스냅샷 + 작성자 정보를 denormalize 저장
    //   - 뷰어는 share 문서 1건만 읽으면 됨 → problems 권한 변경 불필요, 비로그인도 접근 가능
    //   - 만료 차단은 클라이언트의 expiresAt 검사 + 소유자의 revoke(=문서 삭제)로 강제
    //   - 본인 소유 share listing 가능 (where ownerUid == uid)
    match /shares/{shareId} {
      // 읽기: 누구나 (shareId는 비밀에 가까운 nanoid)
      allow read: if true;

      // 생성: 로그인 사용자가 자기가 소유한 problem에 대해서만
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/problems/$(request.resource.data.problemId)).data.authorUid == request.auth.uid;

      // 삭제: 소유자만 (revoke)
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      // 수정은 금지 (재발급 = delete + create)
      allow update: if false;
    }

    // ===== folders 컬렉션 =====
    // 본인 폴더만 R/W
    match /folders/{folderId} {
      allow read, update, delete: if request.auth != null
        && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.user_id == request.auth.uid;
    }
  }
}
