rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 전역 헬퍼 =====
    // Phase 52(A2): 관리자 식별 — admins/{uid} 문서 존재 여부.
    //   uid를 규칙에 하드코딩하지 않음(public 레포 비노출). 관리자 추가/제거는
    //   콘솔에서 admins 문서 생성/삭제로 처리(규칙 재배포 불요). exists()는 read 규칙과 무관.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ===== admins 컬렉션 (Phase 52: 관리자 화이트리스트) =====
    // 문서 ID = 관리자 uid, 내용 무관(빈 문서로 충분). 콘솔에서만 관리.
    // 클라이언트 read/write 모두 차단 — isAdmin()의 exists()는 이 규칙을 우회해 동작.
    match /admins/{uid} {
      allow read, write: if false;
    }

    // ===== users 컬렉션 =====
    // 누구나 다른 사용자의 표시명/사진 조회 가능 (공유 시 작성자 표시용)
    // 단, 본인 문서만 쓰기 가능
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // 사용자 스니펫: 본인만
      match /math_snippets/{snippetId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 수식 툴바 설정(Phase 40): 본인만
      match /toolbar_config/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ===== nicknames 컬렉션 (Phase 48: 닉네임 전역 유일성 예약) =====
    // 문서 ID = nickname_lower, { uid }. updateNickname() 트랜잭션이 교체(delete+create).
    match /nicknames/{nick} {
      allow read: if request.auth != null;                  // 중복확인·검색 (users read와 동일 정책)
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid']);
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow update: if false;                                // 교체 = delete + create
    }

    // ===== problems 컬렉션 =====
    match /problems/{problemId} {

      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner() {
        return isSignedIn() && resource.data.authorUid == request.auth.uid;
      }
      function visibility() {
        return resource.data.get('visibility', 'private');
      }
      function isPublic() {
        return visibility() == 'public';
      }
      // Stage 2: 멤버 공유
      function isMember() {
        return isSignedIn()
          && (request.auth.uid in resource.data.get('memberUids', []));
      }
      // 멤버 본인 "공유 해제" — members/memberUids/updated_at만 변경하고 자기 uid를 제거
      function isMemberSelfLeave() {
        return isSignedIn()
          && (request.auth.uid in resource.data.get('memberUids', []))
          && !(request.auth.uid in request.resource.data.get('memberUids', []))
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['members', 'memberUids', 'updated_at']);
      }

      // 읽기: 본인 OR public OR member
      allow read: if isOwner() || isPublic() || isMember();

      // 생성: 로그인한 사용자가 자기 이름으로만 작성 가능
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid;

      // 수정: 오너 OR 멤버 본인 공유 해제 / 삭제: 오너만
      allow update: if isOwner() || isMemberSelfLeave();
      allow delete: if isOwner();

      // ===== problems/{id}/* 일반 서브컬렉션 (블록, 기타) =====
      // tab_comments는 아래 별도 match에서 처리하므로 여기서 명시적으로 제외.
      match /{subcollection}/{docId} {
        function parentData() {
          return get(/databases/$(database)/documents/problems/$(problemId)).data;
        }
        function parentOwner() {
          return isSignedIn() && parentData().authorUid == request.auth.uid;
        }
        function parentIsPublic() {
          return parentData().get('visibility', 'private') == 'public';
        }
        function parentIsMember() {
          return isSignedIn()
            && (request.auth.uid in parentData().get('memberUids', []));
        }
        function tabIdFromSubcol() {
          return subcollection.split('_blocks')[0];
        }
        function isBlocksSubcol() {
          return subcollection.matches('.*_blocks');
        }
        function tabAllowedForMember() {
          return parentData().get('memberTabVisibility', {})
            .get(tabIdFromSubcol(), true) == true;
        }
        // Phase 51(4-1): 공개 문항도 memberTabVisibility 탭 게이트 적용(멤버·공개 공용 필드)
        function tabAllowedForPublic() {
          return parentData().get('memberTabVisibility', {})
            .get(tabIdFromSubcol(), true) == true;
        }
        function isCommentsCol() {
          return subcollection == 'tab_comments';
        }
        // Phase 55: versions는 아래 별도 match에서 처리 → 와일드카드에서 제외 (F2 노출 차단)
        function isVersionsCol() {
          return subcollection == 'versions';
        }

        // 탭 블록(xxx_blocks): 멤버·공개 모두 해당 탭이 공개일 때만 읽기
        // tab_comments·versions는 별도 매치에서 처리하므로 여기선 항상 false
        allow read: if !isCommentsCol() && !isVersionsCol() && (
          parentOwner()
          || (parentIsPublic() && (!isBlocksSubcol() || tabAllowedForPublic()))
          || (parentIsMember() && (!isBlocksSubcol() || tabAllowedForMember()))
        );
        // 쓰기는 오너만 (tab_comments·versions 제외)
        allow write: if !isCommentsCol() && !isVersionsCol() && parentOwner();
      }

      // ===== problems/{id}/versions/{versionId} (Phase 55 자체 VCS) =====
      // author_uid 비정규화 → 목록 조회 시 get() 없이 소유 검사(F2). 본문은 payload/data로 분리(불변).
      match /versions/{versionId} {
        allow read:   if isSignedIn() && resource.data.author_uid == request.auth.uid;
        allow create: if isSignedIn()
          && request.resource.data.author_uid == request.auth.uid
          // 위조 방지: 비정규화 값이 실제 부모 소유자와 일치해야 함 (create 1회만 get)
          && request.resource.data.author_uid
             == get(/databases/$(database)/documents/problems/$(problemId)).data.authorUid;
        // 사후 수정은 name·pinned만 허용 (불변성 강제)
        allow update: if isSignedIn() && resource.data.author_uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'pinned']);
        allow delete: if isSignedIn() && resource.data.author_uid == request.auth.uid;

        // 본문(무거움): 부모 버전 메타의 author_uid로 검사, 본문 자체는 불변
        match /payload/{doc} {
          allow read, create, delete: if isSignedIn()
            && get(/databases/$(database)/documents/problems/$(problemId)/versions/$(versionId)).data.author_uid == request.auth.uid;
          allow update: if false;
        }
      }

      // ===== problems/{id}/tab_comments/{commentId} (Stage 3) =====
      // 권한 정책:
      //   - read: 오너 OR (멤버 && 댓글 보임) OR (공개 문항 && 댓글 보임) — 공개는 비로그인 포함(Phase 51)
      //   - create: 오너 또는 commenter 역할 멤버 (author는 본인) — 공개 작성은 미지원(멤버 전용)
      //   - update content: 작성 본인만 (content + updatedAt만 변경)
      //   - update resolved: 작성자 또는 오너 (resolved + updatedAt만 변경)
      //   - delete: 작성 본인 OR 오너(모더레이션, Phase 51) / AI는 오너만
      match /tab_comments/{commentId} {
        function parentData() {
          return get(/databases/$(database)/documents/problems/$(problemId)).data;
        }
        function isOwnerCmt() {
          return isSignedIn() && parentData().authorUid == request.auth.uid;
        }
        function isMemberCmt() {
          return isSignedIn()
            && (request.auth.uid in parentData().get('memberUids', []));
        }
        function memberRole() {
          return parentData().get('members', {}).get(request.auth.uid, '');
        }
        function isCommenter() {
          return memberRole() == 'commenter';
        }
        // Phase 51(4-2): 공개 문항이면 비로그인 포함 누구나 댓글 읽기 허용
        function parentIsPublic() {
          return parentData().get('visibility', 'private') == 'public';
        }
        // Phase 47: 문항 단위 댓글 제어 (미설정 = true)
        function commentsVisible() {
          return parentData().get('commentsVisible', true) == true;
        }
        function commentsWritable() {
          return parentData().get('commentsWritable', true) == true;
        }
        // Phase 47: 멤버는 댓글 세션(또는 legacy null)에만 작성. agent(normal) 세션 차단.
        function isCommentSessionRef(sid) {
          return sid == null
            || get(/databases/$(database)/documents/problems/$(problemId)/discussion_sessions/$(sid)).data.type == 'comment';
        }
        // Phase 52(C3/F6): 공개 작성자는 문항의 댓글 세션 포인터(commentSessionId)를
        //   '정확히' 참조해야 한다. null 우회 차단 + agent 세션 차단을 추가 get() 없이 보장.
        //   (commentSessionId는 ensureCommentSession이 게시 시 비정규화 — §6-2 load-bearing)
        function isThePublicCommentSession(sid) {
          return sid != null && sid == parentData().get('commentSessionId', null);
        }
        // Phase 52(N1): 공개 댓글 작성 전용 opt-in 플래그(미설정 = false).
        //   멤버 작성 동결용 commentsWritable과 분리 — 두 청중(멤버/공개)을 독립 제어.
        //   기존 public 문항은 이 필드가 없어 기본 차단(자동 개방 방지).
        function publicCommentsEnabled() {
          return parentData().get('publicCommentsEnabled', false) == true;
        }
        function changedKeys() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }

        // 읽기: 오너 OR (멤버 && 댓글 보임) OR (공개 && 댓글 보임).
        // (탭별 가시성을 read에 걸면 Firestore list 쿼리가 사전 검증 불가 → 탭 검사 제거.
        //  commentsVisible는 부모 문서 기반이라 list 쿼리에서도 안전.
        //  Phase 51: 공개 문항은 비로그인 포함 누구나 댓글 읽기 가능(isSignedIn 미요구) — 본문 열람과 일관.
        //  Phase 52(B1): 공개(비멤버) read는 commentStream==true 메시지만 — agent('normal' 세션)
        //     메시지의 규칙레벨 노출 차단. LIST 쿼리는 where('commentStream','==',true) 강제(정적 리터럴).
        //     오너·멤버는 제약 없음(에디터 전체 열람). 기존 댓글은 백필 필요(공개 문항 한정).
        allow read: if isOwnerCmt()
          || (isMemberCmt() && commentsVisible())
          || (parentIsPublic() && commentsVisible() && resource.data.commentStream == true);

        // 생성 (Phase 47):
        //  (a) 인간 댓글: 오너 OR (commenter && 댓글 쓰기 허용 && 댓글 세션). author 본인.
        //  (b) AI 댓글: 오너만 가능. authorUid='ai:*', authorType='ai'.
        allow create: if (
          // 인간 댓글
          (
            request.resource.data.get('authorType', 'human') == 'human'
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.resolved == false
            && (
              isOwnerCmt()
              || (isMemberCmt() && isCommenter() && commentsWritable()
                  && isCommentSessionRef(request.resource.data.get('discussionSessionId', null)))
              // Phase 52(C3): 공개 문항이면 로그인한 누구나 댓글 작성.
              //   N1: publicCommentsEnabled(전용 opt-in) — 기존 public 문항 자동개방 차단·멤버와 분리.
              //   F5: commentsVisible까지 요구 — 숨긴 댓글을 못 읽으면서 쓰는 모순 방지.
              //   F6: 문항 commentSessionId 정확 참조(null·agent 세션 우회 차단).
              //   B1: commentStream==true 요구 — 공개 작성분이 공개 read 규칙·필터 쿼리에 일관되게 노출.
              || (parentIsPublic() && publicCommentsEnabled() && commentsVisible()
                  && isThePublicCommentSession(request.resource.data.get('discussionSessionId', null))
                  && request.resource.data.get('commentStream', false) == true)
            )
          )
          ||
          // AI 댓글
          (
            request.resource.data.authorType == 'ai'
            && request.resource.data.authorUid.matches('^ai:.*')
            && request.resource.data.resolved == false
            && isOwnerCmt()
          )
        );

        // 수정:
        //  (a) 인간 댓글 본인이 content 수정 — content/updatedAt만
        //  (b) 인간 댓글 작성자 또는 오너가 resolved 토글 — resolved/updatedAt만
        //  (c) AI 댓글은 오너만 resolved 토글 가능. content 수정 불가.
        allow update: if (
          resource.data.get('authorType', 'human') == 'human'
          && (
            (
              resource.data.authorUid == request.auth.uid
              && changedKeys().hasOnly(['content', 'updatedAt'])
            )
            || (
              (resource.data.authorUid == request.auth.uid || isOwnerCmt())
              && changedKeys().hasOnly(['resolved', 'updatedAt'])
            )
          )
        ) || (
          resource.data.authorType == 'ai'
          && isOwnerCmt()
          && changedKeys().hasOnly(['resolved', 'updatedAt'])
        ) || (
          // Phase 52(B1): 오너가 commentStream 플래그만 갱신(기존 댓글 백필용).
          //   본인 문항 댓글에 한정. 공개 노출 여부는 오너 본인 콘텐츠 결정이라 안전.
          isOwnerCmt()
          && changedKeys().hasOnly(['commentStream'])
        );

        // 삭제:
        //  - 인간 댓글: 작성 본인 OR 오너(Phase 51 모더레이션 — 댓글이 공개로 노출되므로
        //    오너가 부적절 멤버 댓글을 내릴 수 있어야 함. 기존 "오너도 남의 댓글 삭제 불가" 정책 폐기)
        //  - AI 댓글: 문제 오너만 (길거나 잘린 AI 답변 정리용, Phase 41)
        allow delete: if (
          resource.data.get('authorType', 'human') == 'human'
          && (resource.data.authorUid == request.auth.uid || isOwnerCmt())
        ) || (
          resource.data.authorType == 'ai'
          && isOwnerCmt()
        );
      }

      // ===== problems/{id}/discussion_sessions/{sid} (Phase 37 / 47) =====
      // 권한 정책:
      //   - read: 오너 OR 멤버
      //   - create: 'comment'(댓글, 오너만, aiEnabled=false) OR 'normal'(agent, 오너만, aiEnabled=true). createdBy=본인.
      //   - update: type='normal'만. 생성자 본인 OR 오너. name/updatedAt만 변경.
      //   - delete: type='normal'만. 생성자 본인 OR 오너.
      //   ('comment' 세션은 ensureCommentSession 멱등 생성 — 이름변경/삭제 불가)
      match /discussion_sessions/{sessionId} {
        function pData() {
          return get(/databases/$(database)/documents/problems/$(problemId)).data;
        }
        function isOwnerSess() {
          return isSignedIn() && pData().authorUid == request.auth.uid;
        }
        function isMemberSess() {
          return isSignedIn()
            && (request.auth.uid in pData().get('memberUids', []));
        }
        function sessChangedKeys() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }

        allow read: if isOwnerSess() || isMemberSess();

        // 댓글 세션(comment): 오너만, AI 비활성
        allow create: if request.resource.data.type == 'comment'
          && request.resource.data.aiEnabled == false
          && request.resource.data.createdBy == request.auth.uid
          && isOwnerSess();
        // agent 세션(normal): 오너만, AI 활성
        allow create: if request.resource.data.type == 'normal'
          && request.resource.data.aiEnabled == true
          && request.resource.data.createdBy == request.auth.uid
          && isOwnerSess();

        allow update: if resource.data.type == 'normal'
          && (resource.data.createdBy == request.auth.uid || isOwnerSess())
          && sessChangedKeys().hasOnly(['name', 'updatedAt']);

        allow delete: if resource.data.type == 'normal'
          && (resource.data.createdBy == request.auth.uid || isOwnerSess());
      }
    }

    // ===== shares 컬렉션 (Stage 1: 공유 링크 — 스냅샷 모델) =====
    //   - share 문서에 problem + tabBlocks 스냅샷 + 작성자 정보를 denormalize 저장
    //   - 뷰어는 share 문서 1건만 읽으면 됨 → problems 권한 변경 불필요, 비로그인도 접근 가능
    //   - 만료 차단은 클라이언트의 expiresAt 검사 + 소유자의 revoke(=문서 삭제)로 강제
    //   - 본인 소유 share listing 가능 (where ownerUid == uid)
    match /shares/{shareId} {
      // 읽기: 누구나 (shareId는 비밀에 가까운 nanoid)
      allow read: if true;

      // 생성: 로그인 사용자가 자기가 소유한 problem에 대해서만
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/problems/$(request.resource.data.problemId)).data.authorUid == request.auth.uid;

      // 삭제: 소유자만 (revoke)
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      // 수정은 금지 (재발급 = delete + create)
      allow update: if false;
    }

    // ===== bazaar_posts 컬렉션 (Phase 52: 공용 광장 피드) =====
    //   - "광장 게시"는 공개(visibility)와 별개의 명시적 행위(C1). 등록해야 피드에 노출.
    //   - read: 비로그인 포함 공개(D1). 공개 Bazaar 랜딩(/bazaar)에서 익명 열람.
    //     게시는 "명시적 공개 동의"라 /p·/shared(이미 비로그인 공개)와 일관.
    //   - create: 본인 소유 문항 + author 본인 + 형태 검증(F7).
    //       live는 게시 시점에 문항이 이미 public이어야 함(F1) — /p 뷰어 read가 isPublic 의존.
    //   - update: 게시자 본인, 태그·제목 비정규화만(사후 태그 편집). mode/problemId/ownerUid/shareId 불변.
    //   - delete: 게시자 본인(중단) OR 관리자(takedown, A2 — bazaar_reports와 함께 Phase 52 포함).
    //   - 개수 제한(live 1·snapshot 2)은 규칙으로 강제 불가(list 불가) → 클라 검사(§리스크 R3).
    match /bazaar_posts/{postId} {
      function bp() { return request.resource.data; }
      function problemData(pid) {
        return get(/databases/$(database)/documents/problems/$(pid)).data;
      }
      // create 형태 검증: 필드 타입 + mode/shareId 정합 + 태그 개수 한도(array-contains-any 10)
      function validCreateShape() {
        return bp().ownerUid == request.auth.uid
          && bp().mode in ['live', 'snapshot']
          && bp().problemId is string
          && bp().title is string
          && bp().title_lower is string
          && bp().authorNickname is string
          && bp().authorNickname_lower is string
          && bp().tags is list && bp().tags.size() <= 10
          && (
            (bp().mode == 'snapshot' && ('shareId' in bp().keys()) && bp().shareId is string)
            || (bp().mode == 'live' && !('shareId' in bp().keys()))
          );
      }

      allow read: if true;   // D1: 비로그인 포함 공개 열람

      allow create: if request.auth != null
        && validCreateShape()
        && problemData(bp().problemId).authorUid == request.auth.uid
        // F1: live 게시는 문항이 이미 공개 상태여야 함(스냅샷은 shares 자체가 비로그인 접근).
        && (bp().mode == 'snapshot'
            || problemData(bp().problemId).get('visibility', 'private') == 'public');

      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['tags', 'title', 'title_lower']);

      // 삭제: 게시자 본인(중단) OR 관리자(takedown, A2).
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.ownerUid == request.auth.uid);
    }

    // ===== bazaar_reports 컬렉션 (Phase 52: 제3자 신고 + 관리자 takedown, A2) =====
    //   - "신고만 받고 조치 불가"인 중간 상태를 피하려 신고 적재 + admin 삭제를 함께 도입.
    //   - create: 로그인 사용자가 본인 명의로 신고 적재(reporterUid 본인, postId 문자열).
    //   - read/delete: 관리자만(콘솔 admins 화이트리스트). 일반 사용자는 자기 신고도 못 읽음.
    //   - update: 금지(신고는 불변 — 재신고는 새 문서).
    match /bazaar_reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.postId is string;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // ===== sessions 컬렉션 (단일 활성 세션) =====
    // sessions/{uid}: { sessionId, updatedAt }
    // 본인만 자기 문서 R/W. 다른 탭/기기에서 로그인하면 이 문서가 덮어써져
    // 기존 탭의 onSnapshot이 sessionId 불일치를 감지하여 자동 로그아웃됨.
    match /sessions/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ===== folders 컬렉션 =====
    // 본인 폴더만 R/W
    match /folders/{folderId} {
      allow read, update, delete: if request.auth != null
        && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.user_id == request.auth.uid;
    }

    // Phase 37: AI 모델 레지스트리 — 비밀이 아닌 공개 설정. 콘솔에서만 관리
    match /ai_models/{modelId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
