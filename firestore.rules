rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== users 컬렉션 =====
    // 누구나 다른 사용자의 표시명/사진 조회 가능 (공유 시 작성자 표시용)
    // 단, 본인 문서만 쓰기 가능
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // 사용자 스니펫: 본인만
      match /math_snippets/{snippetId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ===== problems 컬렉션 =====
    match /problems/{problemId} {

      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner() {
        return isSignedIn() && resource.data.authorUid == request.auth.uid;
      }
      function visibility() {
        return resource.data.get('visibility', 'private');
      }
      function isPublic() {
        return visibility() == 'public';
      }

      // 읽기: 본인 OR public.
      // 'link' 공유는 별도 shares/{shareId} 문서에 스냅샷을 저장하는 방식이므로
      // 여기서 'link' visibility는 따로 처리하지 않는다.
      allow read: if isOwner() || isPublic();

      // 생성: 로그인한 사용자가 자기 이름으로만 작성 가능
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid;

      // 수정/삭제: 본인만
      allow update, delete: if isOwner();

      // ===== problems/{id}/* 모든 서브컬렉션 =====
      // question_blocks, solution_blocks, extra_N_blocks, comments, suggestions, versions
      match /{subcollection}/{docId} {
        function parentData() {
          return get(/databases/$(database)/documents/problems/$(problemId)).data;
        }
        function parentOwner() {
          return isSignedIn() && parentData().authorUid == request.auth.uid;
        }
        function parentVisibility() {
          return parentData().get('visibility', 'private');
        }
        function parentIsPublic() {
          return parentVisibility() == 'public';
        }

        // 'link' 공유는 shares 스냅샷으로 별도 처리 (여기서 link 허용 안 함)
        allow read: if parentOwner() || parentIsPublic();
        allow write: if parentOwner();
      }
    }

    // ===== shares 컬렉션 (Stage 1: 공유 링크 — 스냅샷 모델) =====
    //   - share 문서에 problem + tabBlocks 스냅샷 + 작성자 정보를 denormalize 저장
    //   - 뷰어는 share 문서 1건만 읽으면 됨 → problems 권한 변경 불필요, 비로그인도 접근 가능
    //   - 만료 차단은 클라이언트의 expiresAt 검사 + 소유자의 revoke(=문서 삭제)로 강제
    //   - 본인 소유 share listing 가능 (where ownerUid == uid)
    match /shares/{shareId} {
      // 읽기: 누구나 (shareId는 비밀에 가까운 nanoid)
      allow read: if true;

      // 생성: 로그인 사용자가 자기가 소유한 problem에 대해서만
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/problems/$(request.resource.data.problemId)).data.authorUid == request.auth.uid;

      // 삭제: 소유자만 (revoke)
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      // 수정은 금지 (재발급 = delete + create)
      allow update: if false;
    }

    // ===== folders 컬렉션 =====
    // 본인 폴더만 R/W
    match /folders/{folderId} {
      allow read, update, delete: if request.auth != null
        && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.user_id == request.auth.uid;
    }
  }
}
