rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== users 컬렉션 =====
    // 누구나 다른 사용자의 표시명/사진 조회 가능 (공유 시 작성자 표시용)
    // 단, 본인 문서만 쓰기 가능
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // 사용자 스니펫: 본인만
      match /math_snippets/{snippetId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ===== problems 컬렉션 =====
    match /problems/{problemId} {

      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner() {
        return isSignedIn() && resource.data.authorUid == request.auth.uid;
      }
      function visibility() {
        return resource.data.get('visibility', 'private');
      }
      function isPublic() {
        return visibility() == 'public';
      }
      // Stage 2: 멤버 공유
      function isMember() {
        return isSignedIn()
          && (request.auth.uid in resource.data.get('memberUids', []));
      }
      // 멤버 본인 "공유 해제" — members/memberUids/updated_at만 변경하고 자기 uid를 제거
      function isMemberSelfLeave() {
        return isSignedIn()
          && (request.auth.uid in resource.data.get('memberUids', []))
          && !(request.auth.uid in request.resource.data.get('memberUids', []))
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['members', 'memberUids', 'updated_at']);
      }

      // 읽기: 본인 OR public OR member
      allow read: if isOwner() || isPublic() || isMember();

      // 생성: 로그인한 사용자가 자기 이름으로만 작성 가능
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid;

      // 수정: 오너 OR 멤버 본인 공유 해제 / 삭제: 오너만
      allow update: if isOwner() || isMemberSelfLeave();
      allow delete: if isOwner();

      // ===== problems/{id}/* 일반 서브컬렉션 (블록, 기타) =====
      // tab_comments는 아래 별도 match에서 처리하므로 여기서 명시적으로 제외.
      match /{subcollection}/{docId} {
        function parentData() {
          return get(/databases/$(database)/documents/problems/$(problemId)).data;
        }
        function parentOwner() {
          return isSignedIn() && parentData().authorUid == request.auth.uid;
        }
        function parentIsPublic() {
          return parentData().get('visibility', 'private') == 'public';
        }
        function parentIsMember() {
          return isSignedIn()
            && (request.auth.uid in parentData().get('memberUids', []));
        }
        function tabIdFromSubcol() {
          return subcollection.split('_blocks')[0];
        }
        function isBlocksSubcol() {
          return subcollection.matches('.*_blocks');
        }
        function tabAllowedForMember() {
          return parentData().get('memberTabVisibility', {})
            .get(tabIdFromSubcol(), true) == true;
        }
        function isCommentsCol() {
          return subcollection == 'tab_comments';
        }

        // 탭 블록(xxx_blocks): 멤버는 해당 탭이 공개일 때만 읽기
        // tab_comments는 별도 매치에서 처리하므로 여기선 항상 false
        allow read: if !isCommentsCol() && (
          parentOwner()
          || parentIsPublic()
          || (parentIsMember() && (!isBlocksSubcol() || tabAllowedForMember()))
        );
        // 쓰기는 오너만 (tab_comments 제외)
        allow write: if !isCommentsCol() && parentOwner();
      }

      // ===== problems/{id}/tab_comments/{commentId} (Stage 3) =====
      // 권한 정책:
      //   - read: 오너 OR 멤버 (단, 멤버는 해당 탭이 공개일 때만)
      //   - create: 오너 또는 commenter 역할 멤버 (author는 본인)
      //   - update content: 작성 본인만 (content + updatedAt만 변경)
      //   - update resolved: 작성자 또는 오너 (resolved + updatedAt만 변경)
      //   - delete: 작성 본인만 (오너도 남의 댓글 삭제 불가, resolve로 정리)
      match /tab_comments/{commentId} {
        function parentData() {
          return get(/databases/$(database)/documents/problems/$(problemId)).data;
        }
        function isOwnerCmt() {
          return isSignedIn() && parentData().authorUid == request.auth.uid;
        }
        function isMemberCmt() {
          return isSignedIn()
            && (request.auth.uid in parentData().get('memberUids', []));
        }
        function memberRole() {
          return parentData().get('members', {}).get(request.auth.uid, '');
        }
        function isCommenter() {
          return memberRole() == 'commenter';
        }
        function tabAllowedForMemberCmt(tabId) {
          return parentData().get('memberTabVisibility', {}).get(tabId, true) == true;
        }
        function changedKeys() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }

        // 읽기: 오너 OR 멤버.
        // (탭별 가시성을 read에 걸면 Firestore list 쿼리가 사전 검증 불가하여
        //  멤버가 댓글 목록을 못 받는 문제가 생기므로, 읽기는 멤버 여부만 검사.
        //  create 시점에는 탭 가시성·역할을 그대로 검증한다.)
        allow read: if isOwnerCmt() || isMemberCmt();

        // 생성: 오너 OR commenter 역할. author 본인. 해당 탭 가시성 통과.
        allow create: if request.resource.data.authorUid == request.auth.uid
          && request.resource.data.resolved == false
          && (
            isOwnerCmt()
            || (isMemberCmt() && isCommenter()
                && tabAllowedForMemberCmt(request.resource.data.tabId))
          );

        // 수정:
        //  (a) 본인이 content 수정 — content/updatedAt만
        //  (b) 작성자 또는 오너가 resolved 토글 — resolved/updatedAt만
        allow update: if (
          resource.data.authorUid == request.auth.uid
          && changedKeys().hasOnly(['content', 'updatedAt'])
        ) || (
          (resource.data.authorUid == request.auth.uid || isOwnerCmt())
          && changedKeys().hasOnly(['resolved', 'updatedAt'])
        );

        // 삭제: 작성 본인만
        allow delete: if resource.data.authorUid == request.auth.uid;
      }
    }

    // ===== shares 컬렉션 (Stage 1: 공유 링크 — 스냅샷 모델) =====
    //   - share 문서에 problem + tabBlocks 스냅샷 + 작성자 정보를 denormalize 저장
    //   - 뷰어는 share 문서 1건만 읽으면 됨 → problems 권한 변경 불필요, 비로그인도 접근 가능
    //   - 만료 차단은 클라이언트의 expiresAt 검사 + 소유자의 revoke(=문서 삭제)로 강제
    //   - 본인 소유 share listing 가능 (where ownerUid == uid)
    match /shares/{shareId} {
      // 읽기: 누구나 (shareId는 비밀에 가까운 nanoid)
      allow read: if true;

      // 생성: 로그인 사용자가 자기가 소유한 problem에 대해서만
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/problems/$(request.resource.data.problemId)).data.authorUid == request.auth.uid;

      // 삭제: 소유자만 (revoke)
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      // 수정은 금지 (재발급 = delete + create)
      allow update: if false;
    }

    // ===== sessions 컬렉션 (단일 활성 세션) =====
    // sessions/{uid}: { sessionId, updatedAt }
    // 본인만 자기 문서 R/W. 다른 탭/기기에서 로그인하면 이 문서가 덮어써져
    // 기존 탭의 onSnapshot이 sessionId 불일치를 감지하여 자동 로그아웃됨.
    match /sessions/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ===== folders 컬렉션 =====
    // 본인 폴더만 R/W
    match /folders/{folderId} {
      allow read, update, delete: if request.auth != null
        && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.user_id == request.auth.uid;
    }

    // Phase 37: AI 모델 레지스트리 — 비밀이 아닌 공개 설정. 콘솔에서만 관리
    match /ai_models/{modelId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
